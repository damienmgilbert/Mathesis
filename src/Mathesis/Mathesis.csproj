<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A computer algebra library for .NET with step-by-step explanations: simplify, differentiate, integrate, solve and look up the law behind every step.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Mathesis</Title>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>MathesisIcon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Assets\MathesisIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>


	<ItemGroup>
		<ProjectReference Include="../Mathesis.Core/Mathesis.Core.csproj" />
		<ProjectReference Include="../Mathesis.Numerics/Mathesis.Numerics.csproj" />
		<ProjectReference Include="../Mathesis.LinearAlgebra/Mathesis.LinearAlgebra.csproj" />
		<ProjectReference Include="../Mathesis.Symbolics/Mathesis.Symbolics.csproj" />
		<ProjectReference Include="../Mathesis.Knowledge/Mathesis.Knowledge.csproj" />
		<ProjectReference Include="../Mathesis.Validation/Mathesis.Validation.csproj" />
	</ItemGroup>

</Project>
