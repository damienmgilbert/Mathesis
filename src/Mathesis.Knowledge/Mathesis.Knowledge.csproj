<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The Mathesis knowledge catalog: verified laws, formulas and theorems with their conditions, levels and explanations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Mathesis.Symbolics/Mathesis.Symbolics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalog source: knowledge/<domain>/<topic>.mlaw at the repository root, embedded as knowledge/<domain>/<topic>.mlaw. -->
    <EmbeddedResource Include="../../knowledge/**/*.mlaw" LogicalName="knowledge/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
